# Public browser configuration. These values are safe to expose only when
# Supabase RLS policies are enabled (see supabase/migrations).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Server / Edge Function secrets. Never prefix these with VITE_ and never
# commit their real values. Configure them in Supabase or Vercel instead.
SUPABASE_SERVICE_ROLE_KEY=""
INGEST_SHARED_SECRET=""

# Optional: used only by the local Express compatibility server.
DATA_EXTRACTOR_API_URL=""
DATA_EXTRACTOR_API_KEY=""
DATABASE_URL=""
POSTGRES_SSL="true"
