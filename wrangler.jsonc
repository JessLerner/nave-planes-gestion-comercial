{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nave-planes-gestion-operativa",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
