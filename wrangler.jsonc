{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestioncomercial",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "vars": {
    "SUPABASE_URL": "https://vguoyqfdmwktrsclkqjd.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_zvtQuwJci3FRHIwJSrpE0Q_H7EPj0BV"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7528871f71bd481682da3e8b4be513ee"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true,
      "redact_query_string": true
    }
  }
}
